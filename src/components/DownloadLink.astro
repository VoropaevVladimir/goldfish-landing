---
import Icon from './Icon.astro';

interface Props {
  href: string;
  class?: string;
  /** false — открыть в новой вкладке (PDF и т.п. умеют показываться сами
   *  в браузере), true — принудительно скачать (нужно для форматов вроде
   *  .xlsx, которые браузер отобразить не может). По умолчанию — открыть. */
  download?: boolean;
}

const { href, class: className, download = false } = Astro.props;
---

<a
  class:list={['btn', className]}
  href={href}
  download={download ? true : undefined}
  target={download ? undefined : '_blank'}
  rel={download ? undefined : 'noopener'}
  data-download-btn
>
  <span class="download-icon">
    <Icon name="download" size={18} class="download-icon__glyph download-icon__glyph--download" />
    <Icon name="check" size={18} class="download-icon__glyph download-icon__glyph--check" />
  </span>
  <slot />
</a>

<style is:global>
  .download-icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    inline-size: 18px;
    block-size: 18px;
    flex: none;
  }

  .download-icon__glyph {
    grid-area: 1 / 1;
    transition:
      opacity var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .download-icon__glyph--check { opacity: 0; transform: scale(0.5); }

  [data-download-btn].is-downloaded .download-icon__glyph--download {
    opacity: 0;
    transform: scale(0.5);
  }
  [data-download-btn].is-downloaded .download-icon__glyph--check {
    opacity: 1;
    transform: scale(1);
  }
</style>
