---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '../data/site';
---

<header class="header" data-header>
  <div class="header__inner container">
    <a class="header__logo" href="#top" aria-label="Голдфиш — на главную">
      <Logo size={40} withWordmark />
    </a>

    <nav class="header__nav" aria-label="Основная навигация">
      <ul class="header__list">
        {
          nav.map((item) => (
            <li>
              <a class="header__link" href={`#${item.id}`} data-nav-link={item.id}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--primary header__cta" href="#contacts">Связаться с нами</a>

    <button
      class="header__burger"
      type="button"
      data-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="visually-hidden">Открыть меню</span>
      <Icon name="menu" size={24} />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu hidden>
    <div class="mobile-menu__inner container">
      <button class="mobile-menu__close" type="button" data-menu-close>
        <span class="visually-hidden">Закрыть меню</span>
        <Icon name="x" size={28} />
      </button>

      <nav aria-label="Мобильная навигация">
        <ul class="mobile-menu__list">
          {
            nav.map((item) => (
              <li>
                <a class="mobile-menu__link" href={`#${item.id}`} data-nav-link={item.id}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <a class="btn btn--primary mobile-menu__cta" href="#contacts">Связаться с нами</a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-surface);
    border-bottom: var(--line-w) solid var(--color-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.4vw, 34px);
    block-size: var(--header-h);
    transition: block-size var(--dur) var(--ease);
  }

  /* Сжатие при скролле: 88 → 64. */
  .header[data-compact='true'] .header__inner { block-size: var(--header-h-compact); }

  .header__logo {
    display: inline-flex;
    align-items: center;
  }
  .header__logo:hover { color: var(--color-accent-strong); }

  .header__nav { min-inline-size: 0; }

  .header__list {
    display: flex;
    align-items: center;
    gap: clamp(14px, 1.8vw, 26px);
  }

  .header__link {
    position: relative;
    display: inline-block;
    padding-block: 6px;
    font-size: var(--fs-ui);
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    white-space: nowrap;
  }

  .header__link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    block-size: var(--line-w);
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur) var(--ease);
  }

  .header__link:hover { color: var(--color-ink); }
  .header__link:hover::after { transform: scaleX(1); }

  .header__link[aria-current='true'] {
    color: var(--color-ink);
    font-weight: 600;
  }
  .header__link[aria-current='true']::after { transform: scaleX(1); }

  .header__cta { margin-inline-start: auto; }

  .header__burger {
    display: none;
    margin-inline-start: auto;
    padding: 10px;
    border: var(--line-w) solid var(--color-ink);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }
  .header__burger:hover {
    background: var(--color-ink);
    color: #fff;
  }

  /* --- Мобильное меню ---------------------------------------------------- */

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-surface);
    overflow-y: auto;
  }
  .mobile-menu[hidden] { display: none; }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 5vw, 40px);
    min-block-size: 100%;
    padding-block: 24px 40px;
  }

  .mobile-menu__close {
    align-self: flex-end;
    padding: 10px;
    border: var(--line-w) solid var(--color-ink);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
  }

  .mobile-menu__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mobile-menu__link {
    display: block;
    padding-block: 14px;
    border-bottom: var(--line-w) solid var(--color-line-soft);
    font-size: clamp(1.375rem, 6vw, 1.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }
  .mobile-menu__link:hover { color: var(--color-accent-strong); }
  .mobile-menu__link[aria-current='true'] { color: var(--color-accent-strong); }

  .mobile-menu__cta {
    justify-content: center;
    min-block-size: 52px;
  }

  /* --- Адаптив ----------------------------------------------------------- */

  @media (max-width: 1024px) {
    .header__nav,
    .header__cta { display: none; }
    .header__burger { display: inline-flex; }
  }

  @media (min-width: 1025px) {
    .mobile-menu { display: none; }
  }
</style>
