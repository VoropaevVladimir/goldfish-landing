---
import { contacts } from '../data/site';
import { contactSection } from '../data/content';
---

<section class="section" id="contacts" aria-labelledby="contacts-title">
  <div class="container contacts">
    <h2 class="h2" id="contacts-title">{contactSection.heading}</h2>

    <dl class="contacts__list">
      {
        contacts.map((item) => (
          <div class="contacts__item" data-reveal>
            <dt class="kicker">{item.label}</dt>
            <dd class="contacts__value">
              {
                item.value && item.href ? (
                  <a class="contacts__link" href={item.href}>
                    {item.value}
                  </a>
                ) : item.value ? (
                  item.value
                ) : (
                  <span class="contacts__pending">{item.spec} — уточняется</span>
                )
              }
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .contacts {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 2.6vw, 34px);
  }

  .contacts__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-blocks) var(--gap-cols);
    margin: 0;
    max-inline-size: 760px;
  }

  .contacts__item {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .contacts__value {
    margin: 0;
    font-size: var(--fs-h3);
    font-weight: 600;
    line-height: 1.2;
  }

  .contacts__link {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: var(--color-line-soft);
  }

  .contacts__link:hover {
    color: var(--color-accent-strong);
    text-decoration-color: currentColor;
  }

  /* Значение ещё не получено от заказчика — показываем это явно,
     а не выдуманным номером. */
  .contacts__pending {
    display: inline-block;
    padding: 4px 0;
    border-block-end: var(--line-w) dashed var(--color-line-soft);
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--color-ink-muted);
  }

  @media (max-width: 700px) {
    .contacts__list { grid-template-columns: minmax(0, 1fr); }
  }
</style>
