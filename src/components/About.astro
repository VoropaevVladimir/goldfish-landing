---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { about, features } from '../data/content';
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="about__top">
      <div class="about__text">
        <span class="kicker">{about.kicker}</span>
        <h2 class="h2" id="about-title">
          {
            about.headingLines.map((line, i) => (
              <Fragment>
                {i > 0 && <br />}
                {line}
              </Fragment>
            ))
          }
        </h2>
        <p class="prose">{about.body}</p>
      </div>

      <Photo photo={about.photo} ratio="2 / 1" sizes="(max-width: 900px) 100vw, 55vw" reveal />
    </div>

    <ul class="about__features">
      {
        features.map((feature) => (
          <li class="feature" data-reveal>
            <span class="icon-badge">
              <Icon name={feature.icon} size={22} />
            </span>
            <h3 class="h3">{feature.title}</h3>
            <p>{feature.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__top {
    display: grid;
    grid-template-columns: minmax(0, 45fr) minmax(0, 55fr);
    gap: var(--gap-blocks);
    align-items: start;
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: var(--stack-lg);
  }

  .about__features {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-cols);
    margin-block-start: clamp(36px, 4vw, 56px);
  }

  .feature {
    display: flex;
    flex-direction: column;
    gap: var(--stack-md);
  }

  .feature p { color: var(--color-ink-muted); }

  @media (max-width: 900px) {
    .about__top { grid-template-columns: minmax(0, 1fr); }
    .about__features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 700px) {
    .about__features { grid-template-columns: minmax(0, 1fr); }
  }
</style>
